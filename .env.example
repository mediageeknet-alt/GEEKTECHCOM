# ============================================================================
# GEEKTECH-COM — KONFIGURASI ENVIRONMENT PRODUKSI & KEAMANAN TINGGI
# ============================================================================

# 1. APLIKASI & REVERSE PROXY
NODE_ENV="production"
PORT=3000
APP_URL="https://track.geektech-com.id"
FRONTEND_ORIGIN="https://track.geektech-com.id"

# 2. DATABASE UTAMA (PostgreSQL - Internal Network Only)
POSTGRES_USER="geektech_db_admin"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD_64_CHARS"
POSTGRES_DB="geektech_service_db"
DATABASE_URL="postgresql://geektech_db_admin:CHANGE_ME_STRONG_DB_PASSWORD_64_CHARS@postgres:5432/geektech_service_db?schema=public&sslmode=prefer"

# 3. REDIS CACHING & ANTI-BRUTE FORCE RATE LIMITER (Internal Network Only)
REDIS_PASSWORD="CHANGE_ME_STRONG_REDIS_PASSWORD_64_CHARS"
REDIS_URL="redis://:CHANGE_ME_STRONG_REDIS_PASSWORD_64_CHARS@redis:6379/0"
TRACK_CACHE_TTL_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BAN_SECONDS=900

# 4. KRIPTOGRAFI & KEAMANAN SESI (JWT HttpOnly Cookie + AES-256 PIN Encryption)
# AES_MASTER_KEY wajib 64 karakter hex (32 byte / 256-bit) untuk enkripsi PIN/Pola perangkat
AES_256_MASTER_KEY="a9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8"
JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_TOKEN_SECRET_MIN_64_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_TOKEN_SECRET_MIN_64_CHARS"
CSRF_SECRET="CHANGE_ME_CSRF_HMAC_SECRET_MIN_64_CHARS"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 5. INTEGRASI WHATSAPP GATEWAY (Wablas API + Auto-Fallback ke Direct wa.me)
WABLAS_DOMAIN="https://solo.wablas.com"
WABLAS_API_KEY="YOUR_WABLAS_API_KEY"
WABLAS_SECRET_KEY="YOUR_WABLAS_SECRET_KEY"
IS_WABLAS_ENABLED="false"

# 6. AI STUDIO RUNTIME
GEMINI_API_KEY="MY_GEMINI_API_KEY"

